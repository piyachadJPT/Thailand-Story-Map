generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum StoryStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  OPEN
  RESOLVED
}

enum ReportReason {
  FALSE_INFO // ข้อมูลเท็จหรือบิดเบือน
  INAPPROPRIATE // เนื้อหาไม่เหมาะสม
  COPYRIGHT // ละเมิดลิขสิทธิ์
  PRIVACY // ละเมิดความเป็นส่วนตัว
  SPAM // สแปมหรือโฆษณา
  OTHER // อื่นๆ
}

model User {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  emailVerified DateTime?  @map("email_verified")
  image         String?
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now()) @map("created_at")
  username      String?    @unique
  passwordHash  String?    @map("password_hash")
  bannedAt      DateTime?  @map("banned_at")
  banReason     String?    @map("ban_reason")

  accounts        Account[]
  sessions        Session[]
  stories         Story[]
  reports         Report[]       @relation("ReportReporter")
  resolvedReports Report[]       @relation("ReportResolver")
  auditLogs       AuditLog[]
  adminSessions   AdminSession[]

  @@index([createdAt])
  @@map("users")
}

model AdminSession {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_sessions")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id    String  @id @default(uuid())
  name  String
  slug  String  @unique
  icon  String?
  color String?

  stories Story[]

  @@map("categories")
}

model Province {
  id     String @id @default(uuid())
  name   String
  slug   String @unique
  region String

  stories Story[]

  @@map("provinces")
}

model Story {
  id           String      @id @default(uuid())
  title        String
  slug         String      @unique
  summary      String
  content      String      @db.Text
  latitude     Float
  longitude    Float
  provinceId   String      @map("province_id")
  categoryId   String      @map("category_id")
  authorId     String      @map("author_id")
  status       StoryStatus @default(DRAFT)
  rejectReason String?     @map("reject_reason")
  viewCount    Int         @default(0) @map("view_count")
  sourceUrl    String?     @map("source_url")
  isSensitive  Boolean     @default(false) @map("is_sensitive")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  /// Set the first time the story becomes APPROVED; never changed afterwards.
  publishedAt  DateTime?   @map("published_at")

  province      Province            @relation(fields: [provinceId], references: [id])
  category      Category            @relation(fields: [categoryId], references: [id])
  author        User                @relation(fields: [authorId], references: [id])
  images        StoryImage[]
  tags          StoryTag[]
  reports       Report[]
  slugRedirects StorySlugRedirect[]

  @@index([status])
  @@index([provinceId])
  @@index([categoryId])
  @@index([createdAt])
  @@map("stories")
}

/// Old story slugs that permanently redirect to the story's current URL.
model StorySlugRedirect {
  oldSlug   String   @id @map("old_slug")
  storyId   String   @map("story_id")
  createdAt DateTime @default(now()) @map("created_at")

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId])
  @@map("story_slug_redirects")
}

model StoryImage {
  id        String   @id @default(uuid())
  storyId   String   @map("story_id")
  url       String
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId])
  @@map("story_images")
}

model Tag {
  id   String @id @default(uuid())
  name String
  slug String @unique

  stories StoryTag[]

  @@map("tags")
}

model StoryTag {
  storyId String @map("story_id")
  tagId   String @map("tag_id")

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([storyId, tagId])
  @@map("story_tags")
}

model Report {
  id           String       @id @default(uuid())
  storyId      String       @map("story_id")
  reporterId   String?      @map("reporter_id")
  /// Details typed by the reporter.
  reason       String
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now()) @map("created_at")
  reasonType   ReportReason @default(OTHER) @map("reason_type")
  /// DISMISSED | STORY_HIDDEN
  resolution   String?
  resolvedNote String?      @map("resolved_note")
  resolvedAt   DateTime?    @map("resolved_at")
  resolvedById String?      @map("resolved_by_id")

  story      Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  reporter   User? @relation("ReportReporter", fields: [reporterId], references: [id])
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id])

  @@index([status])
  @@index([storyId])
  @@index([createdAt])
  @@map("reports")
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  action     String
  targetId   String   @map("target_id")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")
  /// STORY | REPORT | USER | ADMIN
  targetType String   @default("STORY") @map("target_type")

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetId])
  @@index([createdAt])
  @@map("audit_logs")
}
